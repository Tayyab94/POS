  <connectionStrings>

    <add name="POSDbConnectionstring" connectionString="Server=TAYYAB;Database=POSDB;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />

    <!--<add name="POSDbConnectionstring" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\POSDB.mdf;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient" />-->

