  </connectionStrings>

  <appSettings>
    <add key="LicenseFilePath" value="license.lic" />
    <add key="TrialDays" value="15" />
  </appSettings>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <userSettings>
    <POS_Shop.Properties.Settings>
      <setting name="IsLoggedIn" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="AuthToken" serializeAs="String">
        <value />
      </setting>
      <setting name="UserName" serializeAs="String">
        <value />
      </setting>
      <setting name="UserId" serializeAs="String">
        <value />
      </setting>
      <setting name="DatabasePath" serializeAs="String">
        <value />
      </setting>
    </POS_Shop.Properties.Settings>
  </userSettings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
